{
  "name": "rasterterm",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop video player that renders moving images as ASCII art",
  "author": "RasterTerm",
  "main": "./out/main/index.js",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tools",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "npm run typecheck && electron-vite build",
    "test:e2e": "npm run build && wdio run wdio.conf.ts",
    "check:all": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "package:mac": "npm run build && electron-builder --mac dmg --universal --config electron-builder.yml --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --arm64 --config electron-builder.yml --publish never",
    "package:dir": "npm run build && electron-builder --dir --config electron-builder.yml --publish never",
    "prepare": "node .husky/install.mjs",
    "postinstall": "install-electron --no"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "@wdio/cli": "9.32.0",
    "@wdio/electron-service": "10.0.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/types": "9.32.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "sass": "1.104.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "webdriverio": "9.32.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "edgedriver": false,
    "electron-winstaller": false,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "geckodriver": false
  }
}
